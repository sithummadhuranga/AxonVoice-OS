# ─────────────────────────────────────────────────────────────────────────────
# AxonVoice OS — Environment Variables Skeleton
# Copy this to `.env` and fill in your actual local values.
# DO NOT COMMIT `.env` TO SOURCE CONTROL.
# ─────────────────────────────────────────────────────────────────────────────

# ── POSTGRESQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=axon_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── RABBITMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── REDIS ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=dev_redis_pass_123
REDIS_PORT=6379

# ── SERVICE PORTS ────────────────────────────────────────────────────────────
GATEWAY_PORT=5000
ORCHESTRATOR_PORT=5001
AGENT_PORT=5002
ADMIN_API_PORT=5003

# ── OLLAMA (Optional Native) ──────────────────────────────────────────────────
# Ollama doesn't run in compose by default. 
# If connecting from Docker to host native Ollama on Windows/Mac:
OLLAMA_BASE_URL=http://host.docker.internal:11434
