###############################################################################
# AxonVoice OS — .gitignore
# Architecture: ARCH-002 (frontend/ + backend/ separation)
# Covers: .NET 10, Node/npm, Python, Docker, Ollama, IDE artefacts, secrets
###############################################################################

# ─────────────────────── AI / DEV-INTERNAL (NEVER COMMIT) ───────────────────
# AI assistant directives, architecture decision records, and internal tooling
# context files — no production value, must not leak into the repo.
.antigravityrules
.github/copilot-instructions.md
docs/
# Keep ONLY the root README
!README.md

# ─────────────────────── SECRETS (CRITICAL — NEVER COMMIT) ──────────────────
.env
.env.local
.env.*.local
# .env.example IS committed — it is the secrets template
*.pfx
*.p12
*.pem
*.key
*.cer
secrets/

# ─────────────────────── .NET 10 / C# ────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Oo]ut/
[Pp]ublish/

# MSBuild / Visual Studio user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.sln.ide
*.pubxml
*.pubxml.user
*.vspscc
*.vssscc
.vs/

# .NET tooling
.dotnet/
project.lock.json
.nuget/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# NuGet artefacts — packages/ is NuGet restore cache, NOT our source
packages/
*.nupkg
*.nuspec
# nuget.config is intentionally NOT ignored (we may need it for private feeds)

# ─────────────────────── NODE / NPM (frontend/) ──────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Vite / React build output
frontend/dist/
frontend/.vite/
frontend/build/

# ─────────────────────── PYTHON (infra/faster-whisper, scripts) ──────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ─────────────────────── DOCKER — local volume mounts ────────────────────────
postgres_data/
rabbitmq_data/
redis_data/
ollama_data/
whisper_cache/

# ─────────────────────── OLLAMA / AI MODEL FILES ─────────────────────────────
# Never commit large model weights — use OLLAMA_SETUP.md pull commands
*.gguf
*.ggml
*.bin
*.safetensors
*.pt
*.onnx
models/
infra/audio/*.wav
infra/audio/*.mp3
infra/audio/*.opus
# Keep the generator script and README, ignore the generated audio binaries
!infra/audio/generate_placeholders.py
!infra/audio/README.md

# ─────────────────────── LOGS ────────────────────────────────────────────────
logs/
*.log
*.log.*
Logs/

# ─────────────────────── IDE / EDITOR ────────────────────────────────────────

# Visual Studio Code — ignore workspace settings but keep shared config
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# JetBrains Rider / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ─────────────────────── OS ARTEFACTS ───────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ─────────────────────── MISC ────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
