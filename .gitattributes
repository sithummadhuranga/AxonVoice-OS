# AxonVoice OS — .gitattributes
# Enforce consistent LF line endings in the repo for cross-platform compatibility.
# Windows contributors get CRLF in their working tree; the repo stores LF.

* text=auto eol=lf

# Force binary — never mangle these
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.gif  binary
*.svg  binary
*.wav  binary
*.opus binary
*.mp3  binary
*.gguf binary
*.bin  binary
*.safetensors binary
*.pt   binary
*.onnx binary

# Force text — always normalise
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.slnx      text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.env*       text eol=lf
