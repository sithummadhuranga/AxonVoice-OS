{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "SecretKey": "${JWT_SECRET_KEY}"
  },

  "Cors": {
    "AllowedOrigin": "${CORS_ALLOWED_ORIGIN}"
  },

  "RateLimit": {
    "PermitPerMinute": "120"
  },

  "ConnectionStrings": {
    "Postgres": "${AXON_DB_CONNECTION}",
    "Redis": "${REDIS_CONNECTION_STRING}",
    "RabbitMQ": "${RABBITMQ_CONNECTION_URI}"
  },

  "ReverseProxy": {
    "Routes": {
      "orchestrator-ws-route": {
        "ClusterId": "orchestrator-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/ws/{**catch-all}"
        }
      },
      "agent-route": {
        "ClusterId": "agent-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/agent/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/admin/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orchestrator-cluster": {
        "Destinations": {
          "orchestrator-primary": {
            "Address": "http://axon-orchestrator:8080"
          }
        }
      },
      "agent-cluster": {
        "Destinations": {
          "agent-primary": {
            "Address": "http://axon-agent:8080"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-primary": {
            "Address": "http://axon-admin-api:8080"
          }
        }
      }
    }
  }
}
